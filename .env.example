# PCB Defect Detection — environment configuration
# Copy this file to .env and customise as needed.
# All keys are prefixed with PCB_ and read by config.py at startup.
# Requires python-dotenv to be installed for .env loading.

# --- Paths -------------------------------------------------------------------
# Leave blank to use the project-relative defaults.
PCB_MODEL_PATH=
PCB_GOLDEN_DIR=
PCB_LOG_DIR=logs

# --- API ---------------------------------------------------------------------
PCB_API_HOST=0.0.0.0
PCB_API_PORT=8000
PCB_MAX_UPLOAD_MB=10

# --- Logging -----------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
PCB_LOG_LEVEL=INFO
